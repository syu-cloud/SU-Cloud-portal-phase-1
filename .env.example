POSTGRES_DB=phase1_dev
POSTGRES_USER=phase1
POSTGRES_PASSWORD=replace-with-a-development-password
DJANGO_SECRET_KEY=replace-with-a-development-secret-key

# 로컬 개발 정책이며 운영 확정값이 아니다.
SIGNUP_MAX_FAILED_ATTEMPTS=5
SIGNUP_GRANT_SECONDS=1800
SIGNUP_RATE_WINDOW_SECONDS=900
SIGNUP_ISSUE_EMAIL_LIMIT=5
SIGNUP_ISSUE_IP_LIMIT=30
SIGNUP_VERIFY_EMAIL_LIMIT=20
SIGNUP_VERIFY_IP_LIMIT=100
SIGNUP_RATE_REDIS_URL=redis://127.0.0.1:6379/2
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
